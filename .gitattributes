# Fins de ligne : LF partout dans le repo (evite le bruit CRLF sous Windows)
* text=auto eol=lf

# Sources / config explicitement en LF
*.swift            text eol=lf
*.md               text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.json             text eol=lf
*.plist            text eol=lf

# Projet Xcode
*.pbxproj          text eol=lf merge=union
*.xcscheme         text eol=lf
*.xcworkspacedata  text eol=lf

# Binaires — aucune conversion de fin de ligne
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
